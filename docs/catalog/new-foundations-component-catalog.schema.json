{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "new-foundations-component-catalog.schema.json",
  "title": "Oath: New Foundations runtime component catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "denizens",
    "relics",
    "edifices",
    "legacies",
    "sites"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3.0"
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "denizens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/denizen"
      }
    },
    "relics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relic"
      }
    },
    "edifices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edifice"
      }
    },
    "legacies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legacy"
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/site"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "suit": {
      "enum": [
        "arcane",
        "beast",
        "discord",
        "hearth",
        "nomad",
        "order"
      ]
    },
    "handlers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"
      }
    },
    "rulesText": {
      "type": "string",
      "pattern": "\\S"
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "persistent", "rulesText"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"
        },
        "persistent": { "type": "boolean" },
        "rulesText": { "$ref": "#/$defs/rulesText" }
      }
    },
    "powers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/power" }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "favor",
        "secrets"
      ],
      "properties": {
        "favor": {
          "type": "integer",
          "minimum": 0
        },
        "secrets": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "denizen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "suit",
        "restrictions",
        "powers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-8])$"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "suit": {
          "$ref": "#/$defs/suit"
        },
        "restrictions": {
          "description": "Placement and locking restrictions; null explicitly means unrestricted.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "site-only",
                  "adviser-only",
                  "locked"
                ]
              },
              "oneOf": [
                {
                  "const": [
                    "site-only"
                  ]
                },
                {
                  "const": [
                    "adviser-only"
                  ]
                },
                {
                  "const": [
                    "adviser-only",
                    "locked"
                  ]
                }
              ]
            }
          ]
        },
        "powers": { "$ref": "#/$defs/powers" }
      }
    },
    "relic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "value",
        "defense",
        "powers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:R(?:0[1-9]|[1-3][0-9]|4[0-7])|grand-scepter)$"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "role": {
          "enum": [
            "ordinary",
            "grand-scepter"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "defense": {
          "type": "integer",
          "minimum": 0
        },
        "powers": { "$ref": "#/$defs/powers" }
      }
    },
    "intactEdificeFace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "restrictions",
        "powers"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "restrictions": {
          "const": ["locked"]
        },
        "powers": { "$ref": "#/$defs/powers" }
      }
    },
    "ruinedEdificeFace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "restrictions",
        "powers"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "restrictions": {
          "type": "null"
        },
        "powers": { "$ref": "#/$defs/powers" }
      }
    },
    "edifice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "suit",
        "intact",
        "ruined"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E(?:0[1-9]|[12][0-9]|30)$"
        },
        "suit": {
          "$ref": "#/$defs/suit"
        },
        "intact": {
          "$ref": "#/$defs/intactEdificeFace"
        },
        "ruined": {
          "$ref": "#/$defs/ruinedEdificeFace"
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "powers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L(?:0[1-9]|[12][0-9]|3[0-6])$"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "powers": { "$ref": "#/$defs/powers" }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "defense",
        "capacity",
        "relicSlots",
        "recoverDifficulty",
        "startingResources",
        "forgeRequirements",
        "handlers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^site:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "defense": {
          "type": "integer",
          "minimum": 0
        },
        "capacity": {
          "type": "integer",
          "minimum": 0
        },
        "relicSlots": {
          "type": "integer",
          "minimum": 0
        },
        "recoverDifficulty": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "startingResources": {
          "$ref": "#/$defs/tokens"
        },
        "forgeRequirements": {
          "oneOf": [
            {
              "$ref": "#/$defs/tokens"
            },
            {
              "type": "null"
            }
          ]
        },
        "handlers": {
          "$ref": "#/$defs/handlers"
        }
      }
    }
  }
}
