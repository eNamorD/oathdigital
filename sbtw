#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tooling="$project_dir/.tooling"
java_home=${JAVA_HOME:-"$tooling/jdk-17.0.19+10/Contents/Home"}
if [ -x "$tooling/sbt/bin/sbt" ]; then
  sbt="$tooling/sbt/bin/sbt"
else
  sbt=$(command -v sbt) || { echo "Install sbt or provide .tooling/sbt" >&2; exit 1; }
fi
if [ ! -x "$java_home/bin/java" ]; then
  echo "Set JAVA_HOME to a JDK (Java 21 for release verification)" >&2
  exit 1
fi
cache="$tooling/cache"

exec "$sbt" \
  -java-home "$java_home" \
  -J-Xms256m \
  -J-Xmx2g \
  -Dsbt.global.base="$cache/sbt-global" \
  -Dsbt.boot.directory="$cache/sbt-boot" \
  -Dsbt.ivy.home="$cache/ivy" \
  -Divy.home="$cache/ivy" \
  -Dcoursier.cache="$cache/coursier" \
  "$@"
